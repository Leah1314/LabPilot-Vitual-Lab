# Copy to `.env` and fill in. NEVER commit `.env` — this repo is public.

# Part A — Daytona H100 sandbox (ESM2 + clustering)
DAYTONA_API_KEY=

# Part B — Fireworks LLM observations (omit to use --offline)
FIREWORKS_API_KEY=

# Part B — optional Braintrust remote eval
BRAINTRUST_API_KEY=

# --- App-specific keys (also see each app's .env.example) ---
# dashboard/.env.local     → FIREWORKS_API_KEY, optional PIPELINE_URL
# pathogen-pathfinder/.env → ANTHROPIC_API_KEY, optional COPILOTKIT_LICENSE_TOKEN
