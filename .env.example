# Copy to `.env` and fill in. NEVER commit `.env` — this repo is public.
# The integrated product path uses ALL of these tools.

# --- Required for full stack ---

# Part A — Daytona H100 sandbox (ESM2 + clustering)
DAYTONA_API_KEY=

# Part B + dashboard Consult — Fireworks LLM (grounded observations + CopilotKit agent)
FIREWORKS_API_KEY=
# Optional model override (defaults differ by surface; see fireworks.md / dashboard README)
# FIREWORKS_MODEL=

# --- Strongly recommended ---

# Part B — Braintrust (optional remote); faithfulness always written to eval/
BRAINTRUST_API_KEY=

# --- App surfaces (also see each app's .env.example) ---

# pathogen-pathfinder/.env  → ANTHROPIC_API_KEY (CopilotKit + Claude agent)
# dashboard/.env.local      → FIREWORKS_API_KEY, optional DAYTONA_API_KEY, PIPELINE_URL
