# --- Fireworks AI (required) ---
# The CopilotKit runtime calls Fireworks directly; there is no separate agent
# process. Get a key at https://app.fireworks.ai/settings/users/api-keys
# NOTE: without a payment method on file Fireworks caps you at 10 requests/min,
# which will not survive a live demo. Add one first.
FIREWORKS_API_KEY=

# Model to use (optional; this is the default). Fall back through
# deepseek-v4-flash then gpt-oss-120b if tool calling is unreliable.
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro

# --- CopilotKit Intelligence (optional) ---
# Set COPILOTKIT_LICENSE_TOKEN to activate the Threads drawer's live thread
# history (server + UI). Without it the drawer shows a locked state.
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# INTELLIGENCE_API_KEY=
