# --- Fireworks AI (required) ---
# The CopilotKit runtime calls Fireworks directly; there is no separate agent
# process. Get a key at https://app.fireworks.ai/settings/users/api-keys
# NOTE: without a payment method on file Fireworks caps you at 10 requests/min,
# which will not survive a live demo. Add one first.
FIREWORKS_API_KEY=

# Model to use (optional; this is the default). Fall back through
# deepseek-v4-pro, deepseek-v4-flash, then gpt-oss-120b if tool calling
# is unreliable.
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p2

# Reasoning effort: none | low | medium | high. Defaults to "none" because
# GLM-5.2's reasoning chain is slow in a live demo (3.0s -> 0.8s with it off).
FIREWORKS_REASONING_EFFORT=none

# --- Convoke MCP (optional) ---
# Convoke (https://www.convoke.bio) as an MCP server over Streamable HTTP,
# exposed to the agent as the queryReferenceEvidence tool for external
# background the loaded dataset cannot answer. Results are passed to the model
# as unverified public reference, never as laboratory measurement.
# Unset → the tool reports "not configured" and the agent answers from the
# loaded dataset alone. Get the endpoint from Convoke; there is no default.
# CONVOKE_MCP_URL=
# CONVOKE_MCP_TOKEN=
# Optional. Pin one tool by name; unset → the first tool the server lists.
# CONVOKE_MCP_TOOL=

# --- CopilotKit Intelligence (optional) ---
# Set COPILOTKIT_LICENSE_TOKEN to activate the Threads drawer's live thread
# history (server + UI). Without it the drawer shows a locked state.
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# INTELLIGENCE_API_KEY=
