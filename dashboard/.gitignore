# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no values and the README tells people to copy it.
!.env.example

# A global core.excludesFile here ignores any directory named "data", which
# silently drops the fixtures that lib/fixtures.ts imports at build time. A
# repo .gitignore outranks the global one, so re-include them explicitly. The
# directory has to be re-included before the files inside it can be.
!data/
!data/*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
