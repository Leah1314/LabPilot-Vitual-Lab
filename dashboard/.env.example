# Copy to .env.local. NEVER commit .env.local — this repo is public.

# Required for the Consult chat panel. Server-side only: it is read in the
# route handler and must never be prefixed NEXT_PUBLIC_, or it ships in the
# client bundle.
FIREWORKS_API_KEY=

# Optional. Falls back to deepseek-v4-pro. If tool calls come back malformed,
# step down to deepseek-v4-flash, then gpt-oss-120b.
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro

# Optional. Daytona sandbox preview URL serving the Part A pipeline, e.g.
# https://8000-<sandboxId>.proxy.daytona.work
# Unset, the dashboard serves the committed mock fixtures and the header chip
# reads MOCK. Set and reachable, it reads LIVE.
# PIPELINE_URL=

# Optional. Silences CopilotKit's anonymous usage telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
