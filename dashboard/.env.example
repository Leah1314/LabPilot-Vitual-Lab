# Copy to .env.local. NEVER commit .env.local — this repo is public.
# LabPilot Virtual Lab — server-side credentials only.

# Required for Ask LabPilot and the CopilotKit runtime.
# Server-side only — never prefix NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional. Luna is the cost-sensitive demo default; use gpt-5.6-terra for
# higher-quality explanations after testing latency and spend.
# OPENAI_MODEL=gpt-5.6-luna

# Optional AWS persistence. When unset, approval stays in the demo session.
# AWS_REGION=us-west-2
# AWS_DYNAMODB_TABLE=labpilot-experiment-plans
# On AWS Amplify, use an IAM service role instead of long-lived access keys.

# Optional. Same key as root Part A — enables Daytona sandbox listing in the UI
# (app/api/daytona).
# DAYTONA_API_KEY=

# Optional. Daytona sandbox preview URL (or any host) serving Contracts 1+2, e.g.
# https://8000-<sandboxId>.proxy.daytona.work
# Unset → committed fixtures after `bun run sync-data`.
# PIPELINE_URL=
# PIPELINE_NAME=Daytona pipeline

# Optional. Silences CopilotKit anonymous usage telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
