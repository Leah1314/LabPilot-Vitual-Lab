# Copy to .env.local. NEVER commit .env.local — this repo is public.
# Part of the integrated monorepo stack (BV-BRC → Daytona → Fireworks → CopilotKit).

# Required for the Consult chat panel and /api/observations.
# Server-side only — never prefix NEXT_PUBLIC_.
FIREWORKS_API_KEY=

# Optional. Falls back to deepseek-v4-pro. If tool calls come back malformed,
# step down to deepseek-v4-flash, then gpt-oss-120b.
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro

# Optional. Same key as root Part A — enables Daytona sandbox listing in the UI
# (app/api/daytona).
# DAYTONA_API_KEY=

# Optional. Daytona sandbox preview URL (or any host) serving Contracts 1+2, e.g.
# https://8000-<sandboxId>.proxy.daytona.work
# Unset → committed fixtures after `bun run sync-data`.
# PIPELINE_URL=
# PIPELINE_NAME=Daytona pipeline

# Optional. Silences CopilotKit anonymous usage telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
