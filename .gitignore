# Secrets - this repo is public. Never commit a real key.
# Copy .env.example to .env and fill it in locally.
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Next.js (dashboard/)
node_modules/
.next/
out/

# Large regenerable pipeline artefacts
# Rebuild with: python pipeline/gpu_embedding_cluster.py
data/embeddings.npy

# A global core.excludesFile on some machines ignores any directory named
# "data", which silently drops the pipeline outputs Parts A and B hand to the
# dashboard — `git add data/` appears to succeed and commits nothing. A repo
# .gitignore outranks the global file, so re-include them here. The directory
# has to be re-included before the files inside it can be.
!data/
!data/*.json
!data/*.csv

# OS
.DS_Store
